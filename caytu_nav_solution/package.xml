<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>caytu_nav_solution</name>
  <version>0.1.0</version>
  <description>Point d'entrée officiel PARC2026 — Goal + Nav2 Client — CAYTU Sito-É</description>
  <maintainer email="liantsoaandreane@gmail.com">Liantsoa — Trinôme 2</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>nav2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>action_msgs</depend>
  <!-- GoalLocator lit task_params.yaml avec PyYAML. -->
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
