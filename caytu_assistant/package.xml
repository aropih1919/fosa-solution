<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>caytu_assistant</name>
  <version>0.1.0</version>
  <description>Assistant ROS 2 : dialogue, LLM, STT et TTS.</description>
  <maintainer email="johny@fosa.mg">Équipe Fosa</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>caytu_config</exec_depend>
  <exec_depend>caytu_interfaces</exec_depend>
  <exec_depend>caytu_nav_solution</exec_depend>
  <exec_depend>caytu_semantic_map</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
