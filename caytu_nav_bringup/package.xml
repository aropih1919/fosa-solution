<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>caytu_nav_bringup</name>
  <version>0.1.0</version>
  <description>Configuration Nav2 pour CAYTU Sito-É — PARC 2026 (Costmaps, Planner, Controller)</description>
  <maintainer email="johny@fosa.mg">Johny — Trinôme 2</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Imports utilisés directement par les deux launch Python. -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- solution_bringup lit la pose de spawn depuis le package officiel. -->
  <exec_depend>parc_robot_bringup</exec_depend>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>nav2_dwb_controller</exec_depend>
  <!-- Dépendances du bringup intégré (carte, localisation et scan filtré). -->
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>laser_filters</exec_depend>
  <exec_depend>caytu_nav_solution</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
