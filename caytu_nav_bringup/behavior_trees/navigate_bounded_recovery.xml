<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <BehaviorTree ID="MainTree">

    <!--
      Behavior Tree de navigation.
      Objectifs :
      - Replanification à 1 Hz
      - 1 retry pour le planner
      - 1 retry pour le controller
      - nombre de recoveries globales borné
      - nettoyage des costmaps avant les recoveries physiques
      - aucun cycle de recovery infini
    -->

    <RecoveryNode
        number_of_retries="2"
        name="NavigateRecovery">

      <!-- NAVIGATION NORMALE                                        -->

      <PipelineSequence name="NavigateWithReplanning">

        <!-- Sélection du controller -->
        <ControllerSelector
            selected_controller="{selected_controller}"
            default_controller="FollowPath"
            topic_name="controller_selector"/>

        <!-- Sélection du planner -->
        <PlannerSelector
            selected_planner="{selected_planner}"
            default_planner="GridBased"
            topic_name="planner_selector"/>

        <!-- Replanification périodique à 1 Hz -->
        <RateController hz="1.0">

          <RecoveryNode
              number_of_retries="1"
              name="ComputePathToPose">

            <ComputePathToPose
                goal="{goal}"
                path="{path}"
                planner_id="{selected_planner}"
                error_code_id="{compute_path_error_code}"/>

            <!-- Recovery spécifique au planner -->
            <Sequence name="PlannerRecovery">

              <WouldAPlannerRecoveryHelp
                  error_code="{compute_path_error_code}"/>

              <ClearEntireCostmap
                  name="ClearGlobalCostmapPlannerRecovery"
                  service_name="global_costmap/clear_entirely_global_costmap"/>

            </Sequence>

          </RecoveryNode>

        </RateController>

        <!-- Suivi du chemin -->
        <RecoveryNode
            number_of_retries="1"
            name="FollowPath">

          <FollowPath
              path="{path}"
              controller_id="{selected_controller}"
              error_code_id="{follow_path_error_code}"/>

          <!-- Recovery spécifique au controller -->
          <Sequence name="ControllerRecovery">

            <WouldAControllerRecoveryHelp
                error_code="{follow_path_error_code}"/>

            <ClearEntireCostmap
                name="ClearLocalCostmapControllerRecovery"
                service_name="local_costmap/clear_entirely_local_costmap"/>

          </Sequence>

        </RecoveryNode>

      </PipelineSequence>


      <!-- RECOVERY GLOBALE                                          -->

      <Sequence name="GlobalRecovery">

        <!--
          On ne lance une recovery globale que si le planner
          ou le controller indique qu'une recovery peut aider.
        -->

        <Fallback name="RecoveryCheck">

          <WouldAControllerRecoveryHelp
              error_code="{follow_path_error_code}"/>

          <WouldAPlannerRecoveryHelp
              error_code="{compute_path_error_code}"/>

        </Fallback>

        <!--
          ReactiveFallback permet de surveiller le changement de goal
          pendant les actions de recovery.
        -->

        <ReactiveFallback name="RecoveryFallback">

          <GoalUpdated/>

          <RoundRobin name="RecoveryActions">

            <!-- Recovery 1 : nettoyer les deux costmaps -->
            <Sequence name="ClearCostmaps">

              <ClearEntireCostmap
                  name="ClearLocalCostmap"
                  service_name="local_costmap/clear_entirely_local_costmap"/>

              <ClearEntireCostmap
                  name="ClearGlobalCostmap"
                  service_name="global_costmap/clear_entirely_global_costmap"/>

            </Sequence>

            <!-- Recovery 2 : rotation de 90 degrés -->
            <Spin
                name="SpinRecovery"
                spin_dist="1.57"
                error_code_id="{spin_error_code}"/>

            <!-- Recovery 3 : courte attente -->
            <Wait
                name="WaitRecovery"
                wait_duration="2.0"
                error_code_id="{wait_error_code}"/>

            <!-- Recovery 4 : petit recul -->
            <BackUp
                name="BackUpRecovery"
                backup_dist="0.20"
                backup_speed="0.10"
                error_code_id="{backup_error_code}"/>

          </RoundRobin>

        </ReactiveFallback>

      </Sequence>

    </RecoveryNode>

  </BehaviorTree>

</root>