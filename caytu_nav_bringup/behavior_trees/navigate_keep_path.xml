<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <BehaviorTree ID="MainTree">

    <!--
      Arbre « chemin stabilisé ». Identique à navigate_bounded_recovery.xml, à
      une ligne près : ComputePathToPose s'adresse au nœud path_keeper
      (server_name="compute_path_stable"), qui interroge le planificateur puis
      ne change de chemin que si le nouveau est nettement meilleur ou si le
      chemin suivi est coupé par un obstacle.

      task_solution.py ne demande cet arbre que si path_keeper répond ; sinon
      Nav2 utilise l'arbre par défaut.
    -->

    <RecoveryNode number_of_retries="4" name="NavigateRecovery">

      <!-- 1. Navigation normale -->
      <PipelineSequence name="NavigateWithReplanning">

        <ControllerSelector
            selected_controller="{selected_controller}"
            default_controller="FollowPath"
            topic_name="controller_selector"/>

        <PlannerSelector
            selected_planner="{selected_planner}"
            default_planner="GridBased"
            topic_name="planner_selector"/>

        <!-- Replanification à 2 Hz : l'évitement vient de la replanification. -->
        <RateController hz="2.0">

          <RecoveryNode number_of_retries="1" name="ComputePathToPose">

            <ComputePathToPose
                goal="{goal}"
                path="{path}"
                planner_id="{selected_planner}"
                server_name="compute_path_stable"
                error_code_id="{compute_path_error_code}"/>

            <Sequence name="PlannerRecovery">
              <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
              <ClearCostmapExceptRegion
                  name="ClearFarGlobalCostmapPlannerRecovery"
                  service_name="global_costmap/clear_except_global_costmap"
                  reset_distance="5.0"/>
            </Sequence>

          </RecoveryNode>

        </RateController>

        <!-- Suivi du chemin -->
        <RecoveryNode number_of_retries="1" name="FollowPath">

          <FollowPath
              path="{path}"
              controller_id="{selected_controller}"
              error_code_id="{follow_path_error_code}"/>

          <Sequence name="ControllerRecovery">
            <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
            <ClearEntireCostmap
                name="ClearLocalCostmapControllerRecovery"
                service_name="local_costmap/clear_entirely_local_costmap"/>
          </Sequence>

        </RecoveryNode>

      </PipelineSequence>

      <!-- 2. Récupération -->
      <Sequence name="GlobalRecovery">

        <!-- Seulement si la cause de l'échec peut être levée par une récupération. -->
        <Fallback name="RecoveryCheck">
          <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
          <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
        </Fallback>

        <!-- Une action par nouvelle tentative, dans l'ordre. -->
        <RoundRobin name="RecoveryActions">

          <Sequence name="ClearCostmaps">
            <ClearEntireCostmap
                name="ClearLocalCostmap"
                service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearCostmapExceptRegion
                name="ClearFarGlobalCostmap"
                service_name="global_costmap/clear_except_global_costmap"
                reset_distance="5.0"/>
          </Sequence>

          <Wait wait_duration="2.0"/>

          <Spin spin_dist="1.57" error_code_id="{spin_error_code}"/>

          <BackUp
              backup_dist="0.20"
              backup_speed="0.10"
              error_code_id="{backup_error_code}"/>

        </RoundRobin>

      </Sequence>

    </RecoveryNode>

  </BehaviorTree>

</root>
