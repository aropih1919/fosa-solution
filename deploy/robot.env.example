# Réglages du déploiement sur le robot. Copier ce fichier en deploy/robot.env
# (non versionné) et l'adapter. Aucun mot de passe ici : SSH le demande.

# Compte SSH partagé donné par les organisateurs.
ROBOT=utilisateur@adresse_du_robot
ROBOT_PORT=22

# setup.bash de l'espace de travail de base du robot, donné par les
# organisateurs (il contient parc_msgs, les messages de l'arbitre). Le nôtre est
# construit par-dessus. « ~ » = dossier personnel du compte DU ROBOT : garder
# les apostrophes, sinon bash le remplace par le dossier personnel du portable.
ROBOT_BASE_SETUP='~/ros2_ws/install/setup.bash'

# Variables ROS du robot si son middleware ou son domaine ne sont pas ceux par
# défaut (deploy/check_link.sh les affiche). Exemple :
#   ROBOT_ROS_ENV="ROS_DOMAIN_ID=0 RMW_IMPLEMENTATION=rmw_cyclonedds_cpp"
ROBOT_ROS_ENV=""

# Notre dossier d'équipe sur le robot (code, cartes, journaux, paquets Python,
# modèle Whisper). /dev/shm est en mémoire vive : vidé à chaque redémarrage du
# robot, même si on oublie deploy/clean.sh. Si les organisateurs demandent un
# dossier sur disque, ou si le robot redémarre souvent : ROBOT_DIR='~/fosa'
# (clean.sh l'efface de la même façon en fin de créneau).
ROBOT_DIR=/dev/shm/fosa
